# Copy to .env for local generation. Leave blank to use retrieval and Dashboard only.
# community/app.py requires a private access password; choose your own locally.
APP_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=512
DEEPSEEK_TEMPERATURE=0.3
DEEPSEEK_TIMEOUT=30
